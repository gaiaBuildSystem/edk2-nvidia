[Defines]
  INF_VERSION                    = 0x0001001b
  BASE_NAME                      = L4TLauncher
  FILE_GUID                      = cbf481fb-b373-4e78-aa7e-8631858e0217
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = L4TLauncher
  MODULE_UNI_FILE                = L4TLauncher.uni
#
#  This flag specifies whether HII resource section is generated into PE image.
#  Required for the embedded splash screen logo (L4TSplash.idf).
#
  UEFI_HII_RESOURCE_SECTION      = TRUE

[Sources]
  L4TLauncher.c
  L4TRootfsValidation.c
  L4TOpteeDecrypt.c
  L4TPreIsoInstaller.c
  L4TSplash.c
  L4TSplash.idf
  nvidiagray1080.bmp

[Packages]
  EmbeddedPkg/EmbeddedPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  ShellPkg/ShellPkg.dec
  NetworkPkg/NetworkPkg.dec
  Silicon/NVIDIA/NVIDIA.dec
  SecurityPkg/SecurityPkg.dec

[LibraryClasses]
  UefiBootServicesTableLib
  UefiApplicationEntryPoint
  BaseMemoryLib
  DebugLib
  DevicePathLib
  UefiLib
  HandleParsingLib
  PrintLib
  FileHandleLib
  UefiRuntimeServicesTableLib
  FdtLib
  AndroidBootImgLib
  SecureBootVariableLib
  OpteeNvLib
  ImageScaleLib

[Guids]
  gNVIDIAPublicVariableGuid
  gFdtTableGuid
  gEfiSecureBootEnableDisableGuid
  gNVIDIATokenSpaceGuid
  gEfiSystemResourceTableGuid
  gEfiGlobalVariableGuid
  gEfiHashAlgorithmSha256Guid

[Protocols]
  gEfiLoadedImageProtocolGuid
  gEfiDevicePathProtocolGuid
  gEfiPartitionInfoProtocolGuid
  gEfiBlockIoProtocolGuid
  gEfiDiskIoProtocolGuid
  gEfiLoadFile2ProtocolGuid
  gEfiPkcs7VerifyProtocolGuid
  gNVIDIAL4TLauncherSupportProtocol
  gNVIDIAPlatformKernelArgsProtocolGuid
  gNVIDIACvmEepromProtocolGuid
  gEfiHash2ServiceBindingProtocolGuid   ## CONSUMES
  gEfiHash2ProtocolGuid                 ## CONSUMES
  #
  # Splash screen support (L4TSplash.c)
  #
  gEfiGraphicsOutputProtocolGuid        ## CONSUMES
  gEfiSimpleTextOutProtocolGuid         ## CONSUMES
  gEfiHiiDatabaseProtocolGuid           ## CONSUMES
  gEfiHiiImageExProtocolGuid            ## CONSUMES
  gEfiHiiPackageListProtocolGuid        ## PRODUCES

[UserExtensions.TianoCore."ExtraFiles"]
  L4TLauncherExtra.uni

